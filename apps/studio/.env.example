# Copy to `.env` to override the defaults in env.ts during local development.
# Only SANITY_STUDIO_-prefixed variables are inlined into the Studio bundle.

SANITY_STUDIO_PROJECT_ID=j6kaz436
# production | staging — in CI this is derived from the branch
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_TITLE=App Studio Monorepo

# Deploy-time only. Minted on the first `sanity deploy`; pin it afterwards so
# redeploys always target the same Studio.
# SANITY_STUDIO_APP_ID=
