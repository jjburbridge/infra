# Copy to `.env` to override the defaults in src/env.ts during local development.
# Only SANITY_APP_-prefixed variables are inlined into the app bundle.

SANITY_APP_PROJECT_ID=j6kaz436
# production | staging — in CI this is derived from the branch
SANITY_APP_DATASET=production

# Deploy-time only.
SANITY_APP_ORGANIZATION_ID=on85MEGl3
SANITY_APP_TITLE=App Studio Monorepo App
# Minted on the first `sanity deploy`; pin it afterwards so redeploys always
# target the same app instead of whichever one exists in the organization.
# SANITY_APP_ID=
